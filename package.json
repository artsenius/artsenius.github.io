{
  "name": "about-me-react",
  "version": "2.0.0",
  "description": "Interactive 'About Me' portfolio — cinematic scroll experience with a live, on-demand test runner.",
  "type": "module",
  "main": "src/index.tsx",
  "scripts": {
    "prepare": "husky install",
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "homepage": "https://www.arthursenko.com/",
  "dependencies": {
    "framer-motion": "^11.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "styled-components": "^5.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@types/styled-components": "^5.1.26",
    "@vitejs/plugin-react": "^4.3.1",
    "gh-pages": "^5.0.0",
    "husky": "^9.1.7",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  },
  "keywords": [
    "react",
    "about me",
    "portfolio",
    "vite",
    "framer-motion"
  ],
  "author": "Arthur Senko",
  "license": "MIT",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
